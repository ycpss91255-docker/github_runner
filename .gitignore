# Per-user Claude Code workspace state (project-level config and skills).
# These live alongside the repo for local development convenience but are
# not part of the github_runner tooling and should not be tracked here.
.claude/
skills-lock.json

# Runner install state. Default RUNNER_HOME (see lib/common.sh) is
# <repo_root>/runners/, containing .bin/<runner-tarball> and per-target
# install dirs like ycpss91255-docker/_org/, ycpss91255-research/_org/.
# Override with RUNNER_HOME=... env var to put state elsewhere; this
# pattern still keeps the repo clean for the default layout.
#
# No trailing slash: matches both the real directory and a symlink (e.g.
# when the user restructures the parent layout into src/ + ../runners/
# and symlinks src/runners -> ../runners).
/runners

# Runner-generated artifacts, ignored anywhere in the tree as a defensive
# safety net for when RUNNER_HOME is overridden to a path inside this
# checkout (the /runners pattern above covers the normal default layout).
# Without this block, an in-checkout RUNNER_HOME would leak the runner's
# registration secrets (.credentials, .credentials_rsaparams) into the
# repo's untracked set, where one careless `git add .` could commit them.
# See #9 for the original analysis.
_diag/
_work/
*.log
.credentials
.credentials_rsaparams
.runner

# Coverage report produced by `make -f Makefile.ci coverage`.
/coverage/

# Listener build output produced by `make build-listener` (#108). The binary
# is built inside a golang container and installed to the host; it is a build
# artifact, never tracked.
/bin/
