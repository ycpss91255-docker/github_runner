# Sample EnvironmentFile for the scale-set listener systemd unit (#109).
#
# Install it as mode 0600 (root-only readable) so the token is never world- or
# group-readable, and it is NEVER committed:
#   sudo install -d -m 0755 /etc/github-runner-listener
#   sudo install -m 0600 deploy/scaleset-listener.env.sample \
#     /etc/github-runner-listener/scaleset-listener.env
#   sudo "${EDITOR:-vi}" /etc/github-runner-listener/scaleset-listener.env
#
# The listener reads the token from this file's environment; it is not passed on
# the command line (so it never appears in the process table) and is not logged.

# --- Required ---------------------------------------------------------------
GITHUB_CONFIG_URL=https://github.com/<org>
GITHUB_TOKEN=<scale-set-admin-token>

# --- Runner type (per-type config, #110/#112/#113) --------------------------
# Preferred: drive scale set + image + concurrency from the runner-type config.
# The Go listener is the authoritative parser; RUNNER_TYPE picks which type this
# unit serves (one listener process -> one homogeneous scale set). With this set,
# SCALE_SET_NAME / RUNNER_IMAGE / MAX_RUNNERS / AUTO_SIZE_DEVICES are ignored.
#RUNNER_TYPES_CONFIG=/etc/github-runner-listener/runner-types.yaml
#RUNNER_TYPE=gpu

# --- OR the discrete-env path (no runner-type config) -----------------------
# Required when RUNNER_TYPES_CONFIG is unset: the NAME of the scale set to
# connect to. This is an IDENTIFIER, not what workflows target -- a workflow's
# runs-on is matched against the scale set's LABELS, which were fixed when the
# scale set was created. The two coincide only when the scale set was created
# with its name as its single label. See deploy/README.md section 0.
SCALE_SET_NAME=<scale-set-name>
# Per-job container image:
#RUNNER_IMAGE=ghcr.io/actions/actions-runner:latest
# Worker-pool bound / capacity basis (0 = default or auto-size):
#MAX_RUNNERS=0
# Auto-size the pool to the host's device count (e.g. GPUs):
#AUTO_SIZE_DEVICES=1
#DEVICE_DETECT_CMD=nvidia-smi
# Per-job watchdog ceiling (seconds; default 6h, 0 disables):
#RUNNER_JOB_MAX_LIFETIME=21600
# Parent dir for per-job temp dirs (default /tmp; add to ReadWritePaths if set):
#RUNNER_WORK_ROOT=/var/lib/github-runner-listener/work
